{
  "name": "adams-library",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types --experimental-transform-types server.ts",
    "build": "vite build --configLoader runner && node scripts/build-worker.mjs",
    "start": "node --experimental-strip-types --experimental-transform-types server.ts --production",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive:true, force:true})\"",
    "lint": "tsc --noEmit",
    "test": "node --experimental-strip-types --experimental-transform-types --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "drizzle-orm": "^0.44.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21",
    "drizzle-kit": "^0.31.4",
    "jsdom": "^26.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
