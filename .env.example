# Backend only. Copy to .env.local for local use; configure hosted keys as Sites secrets.
# Never use VITE_ prefixes for these keys or commit .env.local.
GEMINI_TTS_API_KEY=""
# Optional shared Gemini key for chapter insights (also accepted for TTS).
GEMINI_API_KEY=""
GEMINI_TTS_MODEL="gemini-3.8-flash-lite-tts"
# Google Cloud TTS requires its own enabled Cloud project/API and credentials.
GOOGLE_CLOUD_TTS_API_KEY=""
# Google Cloud service-account JSON: local path only; keep the file outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=""
# Hosted Sites: store the JSON contents as a backend secret with this name.
GOOGLE_CLOUD_TTS_SERVICE_ACCOUNT_JSON=""
